# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (Render provides this automatically)
DATABASE_URL=postgresql://username:password@localhost:5432/varadhi_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web push (VAPID)
# Without both keys the push channel silently degrades to a no-op — the app
# keeps working, users just never receive push. Generate a pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@varadhi.local

# Notification action tokens (Module 2)
# Optional. Falls back to JWT_SECRET + '::notif-action' when unset, so nothing
# needs configuring for actions to work. Set it to rotate action tokens
# independently of session tokens.
# NOTIFICATION_ACTION_SECRET=
# How long an inline push action stays valid. Default 72h, so a notification
# left on a lock screen over a weekend still works.
NOTIFICATION_ACTION_TTL_HOURS=72

# Reminder cron (Module 7)
# One switch for EVERY background sweep: reminders, snooze re-delivery, push
# retries, calendar sync and Teams retries/digests all stop when this is false.
ENABLE_CRON=true
# REMINDER_CRON_SCHEDULE=0 * * * *
# CRON_TIMEZONE=Asia/Kolkata

# ─── Integration secrets at rest (Modules 4 & 5) ──────────────────────────────
# Encrypts calendar OAuth tokens and Teams webhook URLs (AES-256-GCM).
# Optional: falls back to JWT_SECRET + a distinct salt, so the app runs without
# it. SET IT IN PRODUCTION — with the fallback, rotating JWT_SECRET makes every
# stored token undecryptable and users must reconnect their calendars.
# Accepts 64 hex chars (32 bytes) or any passphrase. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# ─── Module 4: Google Calendar / Outlook Calendar Sync ────────────────────────
# WITHOUT these the module still runs, against a built-in MOCK calendar — the
# connect flow, sync, dedupe and conflict handling all work, but nothing
# reaches a real calendar. Adding real credentials switches to the live APIs
# with no code change. GET /api/calendar/providers reports which mode is active.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI must be exactly:
#   {API_PUBLIC_URL}/api/calendar/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Azure Portal → App registrations. Redirect URI:
#   {API_PUBLIC_URL}/api/calendar/outlook/callback
# MS_TENANT_ID defaults to 'common' (any Microsoft account).
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=common
#
# The PUBLIC origin of THIS API, used to build OAuth redirect URIs. Required in
# production: without it the URI is derived from the inbound request, which is
# wrong behind a proxy and will fail the provider's exact-match check.
# API_PUBLIC_URL=https://your-api.onrender.com
#
# Optional. Falls back to JWT_SECRET + '::cal-oauth'.
# CALENDAR_OAUTH_SECRET=
# Sync sweep cadence. 5 minutes meets the PRD's ≤5 min latency target.
# CALENDAR_CRON_SCHEDULE=*/5 * * * *

# ─── Module 5: Microsoft Teams webhooks ───────────────────────────────────────
# No credentials needed — an admin pastes an Incoming Webhook URL in the UI.
# Local hour (0-23, in CRON_TIMEZONE) for daily/weekly summary posts.
# TEAMS_DIGEST_HOUR=9
# TEAMS_RETRY_SCHEDULE=*/2 * * * *
# TEAMS_DIGEST_SCHEDULE=0 * * * *
