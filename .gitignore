node_modules/
uploads/
*.log

# Environment files. Every variant holds live credentials — the only file in
# this family that may be committed is .env.example, which carries key names
# with empty values. A bare `.env` rule does NOT match `.env.dev.backup`,
# `.env.local` or `.env.production`, which is how a backup containing
# DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET, EMAIL_PASS and
# VAPID_PRIVATE_KEY ended up tracked in commit 57712ed.
.env
.env.*
!.env.example

# Regenerated by migrate-schema-split.js on every --apply, and specific to
# whichever database was migrated. A copy in the repo would claim to roll back
# a database it was not generated against — keep the one the run produces.
schema-split-rollback.sql
